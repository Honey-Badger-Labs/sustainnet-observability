# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit .env. These are for local demos only, not for production.

# Required. Used by local Grafana containers and the demo setup scripts.
GRAFANA_ADMIN_PASSWORD=

# Optional. Grafana username (Grafana's own default is admin).
GRAFANA_ADMIN_USER=admin

# Optional. Only needed if a setup script must change Grafana from a
# fresh install's initial password to GRAFANA_ADMIN_PASSWORD.
# Leave blank if you have already set Grafana's password yourself.
GRAFANA_INITIAL_PASSWORD=

# Used by the Family Meal Planner local postgres-exporter.
# POSTGRES_PASSWORD is required if you start that stack.
# Use a simple value with no ":", "@" or "/" characters.
POSTGRES_USER=sustainnet
POSTGRES_PASSWORD=
POSTGRES_DB=sustainnet_local
